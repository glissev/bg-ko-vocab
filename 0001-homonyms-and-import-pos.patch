 migrations/0002_unique_pair.sql |  6 ++++++
 server/app.ts                   |  4 ++--
 shared/lang.ts                  | 33 +++++++++++++++++++++++++++++++++
 src/views/practice.ts           | 26 ++++++++++++++++++++++++--
 src/views/words.ts              | 24 ++++++++++++++++--------
 tests/lang.test.ts              | 29 ++++++++++++++++++++++++++++-
 7 files changed, 115 insertions(+), 14 deletions(-)
